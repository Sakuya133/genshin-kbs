<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/genshin.owl"
         xmlns="http://example.org/genshin.owl#">

<owl:Ontology rdf:about="http://example.org/genshin.owl"/>

<owl:ObjectProperty rdf:about="#hasElement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Element"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasWeapon">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#WeaponType"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRole">
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Role"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#scalesWith">
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Stat"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsSet">
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#ArtifactSet"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#droppedIn">
  <rdfs:domain rdf:resource="#ArtifactSet"/>
  <rdfs:range rdf:resource="#Domain"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendedDomain">
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="#Domain"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#recommendsSet"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#droppedIn"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasShield">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Character"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Character">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Role">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Element">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#WeaponType">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Stat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ArtifactSet">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#HPScaler">
  <rdfs:subClassOf rdf:resource="#Character"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Character"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#scalesWith"/>
          <owl:hasValue rdf:resource="#HP"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Domain">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#HP">
  <rdf:type rdf:resource="#Stat"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ATK">
  <rdf:type rdf:resource="#Stat"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DEF">
  <rdf:type rdf:resource="#Stat"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EM">
  <rdf:type rdf:resource="#Stat"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ER">
  <rdf:type rdf:resource="#Stat"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Hydro">
  <rdf:type rdf:resource="#Element"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Geo">
  <rdf:type rdf:resource="#Element"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sword">
  <rdf:type rdf:resource="#WeaponType"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Polearm">
  <rdf:type rdf:resource="#WeaponType"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SubDPS">
  <rdf:type rdf:resource="#Role"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Support">
  <rdf:type rdf:resource="#Role"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GoldenTroupe">
  <rdf:type rdf:resource="#ArtifactSet"/>
  <droppedIn rdf:resource="#DOMAIN_TODO_A"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#TenacityOfTheMillelith">
  <rdf:type rdf:resource="#ArtifactSet"/>
  <droppedIn rdf:resource="#DOMAIN_TODO_B"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EmblemOfSeveredFate">
  <rdf:type rdf:resource="#ArtifactSet"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#NoblesseOblige">
  <rdf:type rdf:resource="#ArtifactSet"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Furina">
  <rdf:type rdf:resource="#Character"/>
  <hasElement rdf:resource="#Hydro"/>
  <hasWeapon rdf:resource="#Sword"/>
  <hasRole rdf:resource="#SubDPS"/>
  <scalesWith rdf:resource="#HP"/>
  <recommendsSet rdf:resource="#TenacityOfTheMillelith"/>
  <recommendsSet rdf:resource="#GoldenTroupe"/>
  <rdf:type rdf:resource="#HPScaler"/>
  <recommendedDomain rdf:resource="#DOMAIN_TODO_A"/>
  <recommendedDomain rdf:resource="#DOMAIN_TODO_B"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Xingqiu">
  <rdf:type rdf:resource="#Character"/>
  <hasElement rdf:resource="#Hydro"/>
  <hasWeapon rdf:resource="#Sword"/>
  <hasRole rdf:resource="#SubDPS"/>
  <recommendsSet rdf:resource="#NoblesseOblige"/>
  <recommendsSet rdf:resource="#EmblemOfSeveredFate"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Zhongli">
  <rdf:type rdf:resource="#Character"/>
  <hasElement rdf:resource="#Geo"/>
  <hasWeapon rdf:resource="#Polearm"/>
  <hasRole rdf:resource="#Support"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DOMAIN_TODO_A">
  <rdf:type rdf:resource="#Domain"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DOMAIN_TODO_B">
  <rdf:type rdf:resource="#Domain"/>
</owl:NamedIndividual>


</rdf:RDF>
